# Block public access to the .git directory (defense-in-depth; Hostinger
# already returns 403 for it by default, but this makes it explicit).
RedirectMatch 404 /\.git

# Serve GPX as XML so the server compresses it (the tracks shrink ~10x; Hostinger's
# LiteSpeed does not compress the application/gpx+xml type).
AddType application/xml .gpx
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/gpx+xml application/xml text/xml text/html text/css application/javascript text/javascript
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/xml "access plus 7 days"
</IfModule>
